{
    "version": 2,
    "framework": null,
    "functions": {
      "api/index.php": {
        "runtime": "vercel-php@0.6.0"
      }
    },
    "routes": [
      {
        "src": "/(css|js|images|fonts|favicon)/(.*)",
        "dest": "public/$1/$2"
      },
      {
        "src": "/(.*)",
        "dest": "/api/index.php"
      }
    ],
    "env": {
      "APP_NAME": "Laravel",
      "APP_ENV": "production",
      "APP_DEBUG": "false",
      "APP_URL": "https://your-project-url.vercel.app",
      
      "DB_CONNECTION": "mysql",
      "DB_HOST": "your-railway-host",
      "DB_PORT": "your-railway-port",
      "DB_DATABASE": "your-railway-database",
      "DB_USERNAME": "your-railway-username",
      "DB_PASSWORD": "your-railway-password"
    }
  }